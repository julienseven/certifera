# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Connection pooling. Every warm serverless instance holds its own pool, so the
# cluster-wide connection count is (instances x DATABASE_POOL_MAX). Keep this
# small unless you are behind PgBouncer in transaction mode.
DATABASE_POOL_MAX=3
DATABASE_POOL_IDLE_MS=10000
DATABASE_POOL_CONNECT_TIMEOUT_MS=8000
# TLS is on for any non-local host. Set `disable` to force it off, `require` to
# force it on for a local URL. Certificate verification is off by default
# because managed providers use a CA outside the Node bundle.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# SLA escalations attempted per maintenance run. A larger backlog drains across
# runs and is reported as an operational event rather than timing out.
CERTIFERA_MAINTENANCE_BATCH=50

# Public canonical URL used by metadata, robots, sitemap, email links, and share cards
NEXT_PUBLIC_SITE_URL=https://certifera.xyz

# Required for production first-admin bootstrap and protected maintenance cron
CERTIFERA_SETUP_CODE=replace-with-a-long-random-value
# Use CERTIFERA_CRON_SECRET for external schedulers; Vercel Cron also recognizes CRON_SECRET.
CERTIFERA_CRON_SECRET=replace-with-a-second-long-random-value
CRON_SECRET=replace-with-the-same-long-random-value

# Strict identity policies (recommended for production)
CERTIFERA_EMAIL_VERIFICATION_REQUIRED=true
# Use only in local/dev environments to show verification/reset URLs in API responses
CERTIFERA_EXPOSE_AUTH_LINKS=false

# Transactional email through Resend
CERTIFERA_RESEND_API_KEY=
CERTIFERA_MAIL_FROM=Certifera <security@certifera.xyz>

# Required for encrypted MFA secrets: base64-encoded 32-byte value
# Generate with: openssl rand -base64 32
CERTIFERA_FIELD_ENCRYPTION_KEY=

# Private evidence storage. `database` is sandbox-only; use `s3` for production.
CERTIFERA_EVIDENCE_STORAGE=s3
CERTIFERA_S3_BUCKET=certifera-private-evidence
CERTIFERA_S3_REGION=us-east-1
CERTIFERA_S3_ENDPOINT=
CERTIFERA_S3_FORCE_PATH_STYLE=false
CERTIFERA_S3_ACCESS_KEY_ID=
CERTIFERA_S3_SECRET_ACCESS_KEY=

# Optional malware scanning webhook. Require it in production.
CERTIFERA_EVIDENCE_SCAN_REQUIRED=true
CERTIFERA_MALWARE_SCAN_WEBHOOK=
CERTIFERA_MALWARE_SCAN_TOKEN=

# Optional incident alert delivery. Errors and critical events are persisted regardless.
CERTIFERA_ALERT_WEBHOOK=
CERTIFERA_ALERT_WEBHOOK_TOKEN=

# Settlement defaults to sandbox. Set to stripe only after Connect onboarding and compliance review.
CERTIFERA_SETTLEMENT_MODE=sandbox
CERTIFERA_STRIPE_SECRET_KEY=
# Required when CERTIFERA_SETTLEMENT_MODE=stripe. Stripe events are verified at 